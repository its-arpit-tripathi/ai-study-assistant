# --- LLM (answer generation) — the only AI API key you need ---
# Get a free key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
# Optional. Groq retires models regularly; the app falls back to a working one
# automatically. Current list: https://console.groq.com/docs/models
# GROQ_MODEL=openai/gpt-oss-120b

# --- Embeddings ---
# Groq has no embeddings API, so by default embeddings are computed locally on
# the server with a small open model (no key, no quota, ~23 MB download on
# first run). Nothing to configure.
# EMBEDDING_PROVIDER=local
# EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
# EMBEDDING_BATCH_SIZE=8        # lower = less RAM (8 ≈ 300 MB peak)
#
# Optional alternative: Google Gemini embeddings instead of local ones.
# EMBEDDING_PROVIDER=gemini
# GOOGLE_API_KEY=your_google_api_key_here   # https://aistudio.google.com

# --- Vector database ---
# Create a free cluster at https://cloud.qdrant.io
# NOTE: free clusters are suspended after 1 week idle and deleted after 4 weeks.
QDRANT_URL=https://your-cluster-id.region.aws.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key_here

# --- Phase 1: PostgreSQL metadata + authentication ---
# Create a PostgreSQL database and set this to its connection URL.
DATABASE_URL=postgresql://postgres:password@localhost:5432/notebooklm
# Use a long random secret (32+ characters). Example generation: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters
# Optional: set to disable only for local PostgreSQL without TLS. Production defaults to TLS.
# DATABASE_SSL=disable
# PG_POOL_MAX=10

# --- Phase 2: hybrid retrieval and reranking ---
# Cross-encoder reranker loads locally on first use; set false to use lexical reranking only.
RERANKER_ENABLED=true

# --- Production tuning (safe defaults; validate before increasing) ---
# Maximum simultaneous generation+verification pipelines per Node process.
LLM_MAX_CONCURRENCY=8
# Maximum waiting chat requests per process before returning HTTP 503.
LLM_MAX_QUEUE=100
# In-process cache only. Keep 0 to disable; multi-replica production should use
# a shared Redis-compatible cache with the same user/document/version scope.
ANSWER_CACHE_TTL_MS=0
ANSWER_CACHE_MAX_ENTRIES=300
PROMPT_VERSION=v1
# Hybrid retrieval candidate counts and context depth.
VECTOR_CANDIDATES=20
BM25_CANDIDATES=30
RERANKER_CANDIDATES=20
RETRIEVAL_K=7
# Citation verifier (set false to disable second LLM verification call for maximum speed)
CITATION_VERIFIER_ENABLED=true
CITATION_VERIFIER_TIMEOUT_MS=4000
